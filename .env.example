COMPOSE_PROJECT_NAME=nyc-taxi-mlops

# AWS — leave blank on EC2 (IAM role provides credentials automatically)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET=taxi-mlops-nyc

# Airflow
AIRFLOW_UID=1000
AIRFLOW_PROJ_DIR=.

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Email alerts (Gmail App Password — create at myaccount.google.com/apppasswords)
ALERT_EMAIL=you@gmail.com
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optuna hyperparameter search budget
OPTUNA_N_TRIALS=20
